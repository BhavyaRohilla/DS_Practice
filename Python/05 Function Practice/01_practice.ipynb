   "source": [
    "## Number of round of lift\n",
    "def number_round_lift(n,capacity):\n",
    "    temp_round = (n//capacity)\n",
    "    return temp_round+1\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "number_round_lift(10,4)"
   ]
